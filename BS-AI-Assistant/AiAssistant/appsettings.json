{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.SemanticKernel": "Information"
    }
  },
  "AllowedHosts": "*",
  "AiSafety": {
    "MaxRowLimit": 1000,
    "QueryTimeoutSeconds": 30,
    "BlockedKeywords": [
      "DROP",
      "ALTER",
      "TRUNCATE",
      "EXEC",
      "EXECUTE",
      "xp_",
      "sp_",
      "GRANT",
      "REVOKE",
      "DENY",
      "CREATE",
      "MERGE",
      "BULK"
    ]
  },
  "AiSecurity": {
    "RbacCacheMinutes": 3
  }
}
