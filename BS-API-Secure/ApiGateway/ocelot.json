        {
          "Host": "auth_api",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/v1/api/alive",
      "UpstreamHttpMethod": [ "get" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/alive/status",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth_api",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/v1/api/alive/status",
