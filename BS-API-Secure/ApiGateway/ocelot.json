{
  "Routes": [
    {
      "DownstreamPathTemplate": "/auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/v1/api/login",
      "UpstreamHttpMethod": [ "post" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1s",
        "Limit": 5 
      }
    },
    {
      "DownstreamPathTemplate": "/auth/logout",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/v1/api/logout",
      "UpstreamHttpMethod": [ "post" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
      {
      "DownstreamPathTemplate": "/users/reset_password",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "auth_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/v1/api/reset_password",
      "UpstreamHttpMethod": [ "post" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/auth/refresh",
      "DownstreamScheme": "http",
